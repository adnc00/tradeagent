# .env örneği. Kopyalayın: .env  (config.yaml ile aynı klasör)
# Canlı/demo anahtarları ve Telegram bildirimi için gerekir.
# Anahtarlarda YALNIZCA işlem (trade) yetkisi olsun; para çekme (withdraw) KAPALI, IP beyaz listesi AÇIK.
# Değişken adı: <ccxt borsa kimliği büyük harfle>_API_KEY / _API_SECRET
# Bu dosyayı asla paylaşmayın veya sürüm kontrolüne eklemeyin.

# Binance spot (testnet: https://testnet.binance.vision/)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Binance USDⓈ-M futures (demo trading: https://demo.binance.com/)
BINANCEUSDM_API_KEY=
BINANCEUSDM_API_SECRET=

# BtcTurk (spot: canlı bracket desteklenmez, yalnızca ileride gerekirse)
BTCTURK_API_KEY=
BTCTURK_API_SECRET=

# Alpaca (paper hesabı anahtarları önerilir)
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Telegram bildirimi (watch). @BotFather'dan token, getUpdates'ten chat id (README: "Telegram bildirimi").
# Bot yalnızca mesaj gönderir; Telegram'dan gelen hiçbir şey emir onaylayamaz.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
